{
  "name": "llm-space",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "hooks:install": "lefthook install",
    "dev": "cd apps/desktop && bun run dev:hmr",
    "dev:cef": "cd apps/desktop && bun run dev:cef",
    "build:canary": "cd apps/desktop && bun run build:canary",
    "build:stable": "cd apps/desktop && bun run build:stable",
    "release": "bun scripts/release.ts",
    "release:canary": "bun scripts/release.ts --prerelease canary",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "catalog": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-agent-core": "^0.80.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typebox": "^1.2.8"
  },
  "overrides": {
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^9.39.4",
    "eslint-config-zoro": "^9.1.3",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typebox": "catalog:"
  }
}
