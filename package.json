{
  "name": "llm-space",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "dev": "cd apps/desktop && bun run dev:hmr",
    "dev:cef": "cd apps/desktop && bun run dev:cef",
    "build:canary": "cd apps/desktop && bun run build:canary",
    "build:stable": "cd apps/desktop && bun run build:stable",
    "test:docker": "LLM_SPACE_DOCKER_ACCEPTANCE=1 bun test packages/runtime/src/node/sandbox/docker-sandbox-acceptance.test.ts",
    "release": "bun scripts/release.ts",
    "release:canary": "bun scripts/release.ts --prerelease canary",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "pack": "cd apps/desktop && LLM_SPACE_SKIP_SIGNING=1 bun run build:canary",
    "pack:adhoc": "cd apps/desktop && LLM_SPACE_SKIP_NOTARIZE=1 ELECTROBUN_DEVELOPER_ID=- bun run build:canary",
    "pack:signed": "cd apps/desktop && LLM_SPACE_SKIP_NOTARIZE=1 bun run build:canary",
    "pack:feed": "cd apps/desktop && LLM_SPACE_SKIP_SIGNING=1 LLM_SPACE_UPDATE_BASE_URL=http://localhost:8321 bun run build:canary && mkdir -p .dev-feed && cp artifacts/* .dev-feed/",
    "feed:serve": "cd apps/desktop && bun scripts/serve-feed.ts"
  },
  "catalog": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-agent-core": "^0.80.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "typebox": "^1.2.8"
  },
  "overrides": {
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^9.39.4",
    "eslint-config-zoro": "^9.2.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.10",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typebox": "catalog:"
  }
}
