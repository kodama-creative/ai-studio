{
  "name": "@llm-space/desktop",
  "version": "4.9.0",
  "scripts": {
    "start": "vite build && LLM_SPACE_DEEP_LINK_SCHEME=llm-space-dev electrobun dev",
    "dev:watch": "LLM_SPACE_DEEP_LINK_SCHEME=llm-space-dev electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "dev:cef": "LLM_SPACE_DESKTOP_RENDERER=cef LLM_SPACE_DESKTOP_CDP_PORT=${LLM_SPACE_DESKTOP_CDP_PORT:-9333} bun run dev:hmr",
    "hmr": "vite --port ${LLM_SPACE_DESKTOP_DEV_SERVER_PORT:-5173}",
    "build:view": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:canary": "bun run build:view && electrobun build --env=canary",
    "build:stable": "bun run build:view && electrobun build --env=stable"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@dayflow/blossom-color-picker-react": "^1.2.1",
    "@earendil-works/pi-ai": "catalog:",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@llm-space/agent": "workspace:*",
    "@llm-space/core": "workspace:*",
    "@llm-space/pi-runtime": "workspace:*",
    "@llm-space/runtime": "workspace:*",
    "@llm-space/studio": "workspace:*",
    "@llm-space/ui": "workspace:*",
    "@lobehub/icons": "^5.10.1",
    "@sinm/react-chrome-tabs": "^2.6.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "electrobun": "^1.18.1",
    "inversify": "^8.2.3",
    "lucide-react": "^1.28.0",
    "posthog-node": "^5.48.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "timeago.js": "^4.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.3",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.2.0"
  }
}
